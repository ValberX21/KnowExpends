<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:KnowExpends.Mobile.Converters"
             x:Class="KnowExpends.Mobile.MonthReportPage"
             Title="Relatório Mensal"
             BackgroundColor="DarkGreen">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:CategoryToStringConverter x:Key="CategoryToStringConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <!-- Header -->
            <Frame BackgroundColor="White"
                   CornerRadius="12"
                   HasShadow="True"
                   Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="📊 Relatório dos Últimos 30 Dias"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="Black"
                           HorizontalOptions="Center" />
                    
                    <Label x:Name="PeriodLabel"
                           FontSize="16"
                           TextColor="Gray"
                           HorizontalOptions="Center" />

                    <!-- Month Filter -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,10,0,0">
                        <Label Text="Filtrar por mês:" TextColor="Black" VerticalOptions="Center"/>
                        <DatePicker x:Name="MonthPicker"
                                    Grid.Column="1"
                                    Format="MMMM yyyy"
                                    TextColor="Black"
                                    DateSelected="OnMonthSelected"/>
                    </Grid>

                    <!-- Custom Period Filter -->
                    <StackLayout x:Name="CustomPeriodStack" IsVisible="False" Margin="0,10,0,0">
                        <Label Text="Período personalizado:" TextColor="Black" FontAttributes="Bold"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <StackLayout Grid.Column="0">
                                <Label Text="Data inicial:" TextColor="Black" FontSize="14"/>
                                <DatePicker x:Name="StartDatePicker" Format="dd/MM/yyyy" TextColor="Black" DateSelected="OnCustomPeriodChanged"/>
                            </StackLayout>
                            <StackLayout Grid.Column="1">
                                <Label Text="Data final:" TextColor="Black" FontSize="14"/>
                                <DatePicker x:Name="EndDatePicker" Format="dd/MM/yyyy" TextColor="Black" DateSelected="OnCustomPeriodChanged"/>
                            </StackLayout>
                        </Grid>
                    </StackLayout>

                    <!-- View Toggle -->
                    <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Margin="0,10,0,0">
                        <Button x:Name="MonthViewButton" 
                                Text="📅 Mês" 
                                BackgroundColor="DodgerBlue" 
                                TextColor="White"
                                CornerRadius="20"
                                Padding="15,8"
                                Clicked="OnViewToggleClicked"/>
                        <Button x:Name="CustomPeriodButton" 
                                Text="📊 Período" 
                                BackgroundColor="LightGray" 
                                TextColor="Black"
                                CornerRadius="20"
                                Padding="15,8"
                                Margin="10,0,0,0"
                                Clicked="OnViewToggleClicked"/>
                    </StackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Total Summary -->
            <Frame BackgroundColor="DodgerBlue"
                   CornerRadius="12"
                   HasShadow="True"
                   Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <StackLayout Grid.Column="0">
                        <Label Text="💵 Total Geral"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center" />
                        <Label x:Name="TotalAmountLabel"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center" />
                    </StackLayout>
                    
                    <StackLayout Grid.Column="1">
                        <Label Text="📈 Total de Gastos"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center" />
                        <Label x:Name="TotalExpensesLabel"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center" />
                    </StackLayout>
                </Grid>
            </Frame>

            <!-- Category Breakdown -->
            <Label Text="💰 Gastos por Categoria"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="White"
                   Margin="0,10,0,10" />
            <CollectionView x:Name="CategoryCollectionView"
                ItemsSource="{Binding CategorySummaries}"
                SelectionMode="None">
                <!-- disable selection -->
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="White"
                   CornerRadius="12"
                   HasShadow="True"
                   Margin="0,0,0,12"
                   Padding="20"
                   InputTransparent="False">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCategoryTapped"
                                          CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Category Name -->
                                <StackLayout Grid.Column="0">
                                    <Label Text="{Binding Category, Converter={StaticResource CategoryToStringConverter}}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="Black" />
                                    <Label Text="{Binding Count, StringFormat='{0} gastos'}"
                               FontSize="14"
                               TextColor="Gray" />
                                </StackLayout>

                                <!-- Percentage -->
                                <Label Grid.Column="1"
                           Text="{Binding Percentage, StringFormat='{0:F1}%'}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="DodgerBlue"
                           VerticalOptions="Center"
                           Margin="0,0,15,0" />

                                <!-- Amount -->
                                <Label Grid.Column="2"
                           Text="{Binding Total, StringFormat='${0:F2}'}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="Green"
                           VerticalOptions="Center" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Empty State -->
            <Frame x:Name="EmptyStateFrame"
                   BackgroundColor="White"
                   CornerRadius="12"
                   HasShadow="True"
                   Padding="40"
                   IsVisible="False">
                <VerticalStackLayout Spacing="15">
                    <Label Text="❌"
                           FontSize="48"
                           HorizontalOptions="Center" />
                    <Label Text="Nenhum gasto encontrado"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="Black"
                           HorizontalOptions="Center" />
                    <Label Text="No período dos últimos 30 dias"
                           FontSize="14"
                           TextColor="Gray"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
