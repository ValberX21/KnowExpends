<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KnowExpends.Mobile.CategoryExpensesPage"
             BackgroundColor="DarkGreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Frame Grid.Row="0"
               BackgroundColor="White"
               CornerRadius="12"
               HasShadow="True"
               Margin="16,16,16,8"
               Padding="16">
            <VerticalStackLayout Spacing="8">
                <Label x:Name="CategoryTitleLabel"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="Black"
                       HorizontalOptions="Center" />
                <Label x:Name="CategorySummaryLabel"
                       FontSize="14"
                       TextColor="Gray"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Frame>

        <!-- List of Expenses Grouped by Date -->
        <CollectionView Grid.Row="1" 
                        x:Name="ExpensesCollectionView"
                        ItemsSource="{Binding ExpenseGroups}"
                        IsGrouped="True"
                        Margin="16,0,16,16">
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="DodgerBlue"
                           CornerRadius="8"
                           Margin="0,8,0,4"
                           Padding="16,12">
                        <Label Text="{Binding Date}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center" />
                    </Frame>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="White"
                           CornerRadius="12"
                           Margin="0,0,0,8"
                           Padding="20">
                        <Frame.Shadow>
                            <Shadow Opacity="0.35" Radius="8" Offset="0,2" />
                        </Frame.Shadow>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Expense Details -->
                            <StackLayout Grid.Column="0">
                                <Label Text="{Binding Title}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="Black" />
                                <Label Text="{Binding Category}"
                                       FontSize="16"
                                       TextColor="Gray"
                                       Margin="0,6,0,0" />
                                <Label Text="{Binding CreatedDate, StringFormat='Criado em: {0:dd/MM/yyyy HH:mm}'}"
                                       FontSize="12"
                                       TextColor="LightGray"
                                       Margin="0,4,0,0" />
                            </StackLayout>

                            <!-- Price -->
                            <Label Grid.Column="1"
                                   Text="{Binding Price, StringFormat='${0:F2}'}"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="Green"
                                   VerticalOptions="Center"
                                   HorizontalOptions="End" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Empty State -->
        <Frame x:Name="EmptyStateFrame"
               Grid.Row="1"
               BackgroundColor="White"
               CornerRadius="12"
               HasShadow="True"
               Padding="40"
               Margin="16,0,16,16"
               IsVisible="False">
            <VerticalStackLayout Spacing="15">
                <Label Text="❌"
                       FontSize="48"
                       HorizontalOptions="Center" />
                <Label Text="Nenhum gasto encontrado"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="Black"
                       HorizontalOptions="Center" />
                <Label Text="para esta categoria"
                       FontSize="14"
                       TextColor="Gray"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Frame>
    </Grid>

</ContentPage>
