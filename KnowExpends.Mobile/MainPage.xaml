<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KnowExpends.Mobile.MainPage"
             BackgroundColor="DarkGreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Filter Section -->
        <Frame Grid.Row="0"
               BackgroundColor="White"
               CornerRadius="12"
               HasShadow="True"
               Margin="16,16,16,8"
               Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackLayout Grid.Column="0">
                    <Label Text="Filtrar por Categoria"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="Black"
                           Margin="0,0,0,8" />
                    <Picker x:Name="CategoryFilterPicker"
                            Title="Todas as categorias"
                            FontSize="14"
                            TextColor="Black"
                            BackgroundColor="LightGray"
                            HeightRequest="45" />
                </StackLayout>
                
                <Button Grid.Column="1"
                        Text="Limpar"
                        FontSize="14"
                        FontAttributes="Bold"
                        BackgroundColor="Gray"
                        TextColor="White"
                        CornerRadius="8"
                        WidthRequest="80"
                        HeightRequest="45"
                        VerticalOptions="End"
                        Clicked="OnClearFilterClicked" />
            </Grid>
        </Frame>

        <!-- List of Cards Grouped by Date -->
        <CollectionView Grid.Row="1" 
                        x:Name="ExpensesCollectionView"
                        ItemsSource="{Binding ExpenseGroups}"
                        IsGrouped="True"
                        Margin="16,0,16,0">
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="DarkGreen"
                           CornerRadius="8"
                           Margin="0,8,0,4"
                           Padding="16,12">
                        <Label Text="{Binding Date}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center" />
                    </Frame>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="White"
                           CornerRadius="12"
                           Margin="0,0,0,8"
                           Padding="20">
                        <Frame.Shadow>
                            <Shadow Opacity="0.35" Radius="8" Offset="0,2" />
                        </Frame.Shadow>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Expense Details -->
                            <StackLayout Grid.Column="0">
                                <Label Text="{Binding Title}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="Black" />
                                <Label Text="{Binding Category}"
                                       FontSize="16"
                                       TextColor="Gray"
                                       Margin="0,6,0,0" />
                            </StackLayout>

                            <!-- Price -->
                            <Label Grid.Column="1"
                                   Text="{Binding Price, StringFormat='${0:F2}'}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="Green"
                                   VerticalOptions="Center"
                                   Margin="0,0,10,0" />

                            <!-- Edit Button -->
                            <Button Grid.Column="2"
                                    Text="✏️"
                                    FontSize="20"
                                    BackgroundColor="Blue"
                                    TextColor="White"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    CornerRadius="20"
                                    Margin="0,0,5,0"
                                    Clicked="OnEditButtonClicked"
                                    CommandParameter="{Binding .}" />

                            <!-- Delete Button -->
                            <Button Grid.Column="3"
                                    Text="🗑️"
                                    FontSize="20"
                                    BackgroundColor="Red"
                                    TextColor="White"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    CornerRadius="20"
                                    Clicked="OnDeleteButtonClicked"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Navigation Bar with Floating Action Button -->
        <Grid Grid.Row="2" BackgroundColor="Navy" HeightRequest="80">
            <!-- Curved Background -->
            <Frame BackgroundColor="Navy"
                   CornerRadius="0"
                   Margin="0"
                   Padding="0">
                <Frame.Shadow>
                    <Shadow Opacity="0.3" Radius="10" Offset="0,-2" />
                </Frame.Shadow>

                <Grid>
                    <!-- Curved cutout effect using Border -->
                    <Border Stroke="Navy"
                            StrokeThickness="0"
                            BackgroundColor="Navy"
                            HeightRequest="40"
                            VerticalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="0,0,20,20" />
                        </Border.StrokeShape>
                    </Border>
                </Grid>
            </Frame>

            <!-- Right side icons -->
            <StackLayout Orientation="Horizontal" 
                         HorizontalOptions="End" 
                         VerticalOptions="Center"
                         Margin="0,0,60,0">
                <Button Text="📋 "
                        FontSize="20"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        WidthRequest="40"
                        HeightRequest="40"
                        Margin="5"  
                       
                        Clicked="OnClipboardButtonClicked" />                
            </StackLayout>

            <!-- Floating Action Button -->
            <Button x:Name="AddButton"
                    Text="+"
                    FontSize="32"
                    FontAttributes="Bold"
                    BackgroundColor="HotPink"
                    TextColor="White"
                    CornerRadius="35"
                    WidthRequest="70"
                    HeightRequest="70"
                    HorizontalOptions="Center"
                    VerticalOptions="Start"
                    Margin="0,-35,0,0"
                    Clicked="OnAddButtonClicked">
                <Button.Shadow>
                    <Shadow Opacity="0.5" Radius="12" Offset="0,6" />
                </Button.Shadow>
            </Button>
        </Grid>
    </Grid>

</ContentPage>
